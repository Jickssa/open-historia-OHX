index 0000000..ccc2a9a
--- /dev/null
+++ b/src/runtime/ohxExpansion.js
@@ -0,0 +1,103 @@
+/*! Open Historia Expansion Layer — boot, persistence and interactive deck. */
+
+import { readEventsState, readGameData, readWorldState, writeWorldState } from "./gameState.js";
+import { OHXSituationRoom } from "./ohxExpansionUI.js";
+import { buildExpansionState } from "./ohxExpansionEngine.js";
+
+let booted = false;
+let busy = false;
+let pendingTimer = null;
+let currentState = {};
+let situationRoom = null;
+
+const text = (value) => String(value ?? "").trim();
+const arr = (value) => Array.isArray(value) ? value : [];
+const stableComparable = (state) => ({
+  version: state?.version || 1,
+  round: Number(state?.round || 0),
+  gameDate: text(state?.gameDate),
+  metrics: state?.metrics || {},
+  crises: arr(state?.crises),
+  actors: arr(state?.actors),
+  commitments: arr(state?.commitments),
+  storylines: arr(state?.storylines),
+  interactiveDeck: {
+    round: Number(state?.interactiveDeck?.round || 0),
+    offers: arr(state?.interactiveDeck?.offers),
+  },
+  playedMomentIds: arr(state?.playedMomentIds).map(text).filter(Boolean),
+  metricsHistory: arr(state?.metricsHistory),
+});
+
+const sameStable = (a, b) => JSON.stringify(stableComparable(a)) === JSON.stringify(stableComparable(b));
+
+const refreshExpansion = async () => {
+  if (busy) return;
+  busy = true;
+  try {
+    const [world, events, game] = await Promise.all([
+      readWorldState({ force: true }),
+      readEventsState({ force: true }),
+      readGameData({ force: true }),
+    ]);
+    const base = world?.ohx && typeof world.ohx === "object" ? world.ohx : {};
+    const next = buildExpansionState({ world, events, game });
+    next.playedMomentIds = arr(base.playedMomentIds).map(text).filter(Boolean).slice(-280);
+    currentState = next;
+
+    if (!sameStable({ ...base, interactiveDeck: undefined, lastUpdatedAt: undefined }, { ...next, interactiveDeck: undefined, lastUpdatedAt: undefined })
+      || JSON.stringify(base.interactiveDeck) !== JSON.stringify(next.interactiveDeck)) {
+      await writeWorldState({ ...world, ohx: next });
+    }
+    situationRoom?.setState();
+  } catch (error) {
+    console.warn("[OHX] Expansion refresh failed:", error);
+  } finally {
+    busy = false;
+  }
+};
+
+const scheduleRefresh = () => {
+  if (pendingTimer) clearTimeout(pendingTimer);
+  pendingTimer = setTimeout(() => {
+    pendingTimer = null;
+    void refreshExpansion();
+  }, 260);
+};
+
+const playMoment = async (eventId) => {
+  const id = text(eventId);
+  if (!id) return;
+  const world = await readWorldState({ force: true });
+  const round = Number(currentState?.round || 0);
+  const offers = arr(world?.ohx?.interactiveDeck?.offers);
+  if (!offers.some((offer) => text(offer?.eventId) === id)) throw new Error("Moment indisponible.");
+  const played = arr(world?.ohx?.playedMomentIds).map(text).filter(Boolean);
+  if (!played.includes(id)) played.push(id);
+  await writeWorldState({
+    ...world,
+    ohx: { ...(world.ohx || {}), playedMomentIds: played.slice(-280) },
+    interactiveOffer: { eventId: id, round },
+  });
+
+  try {
+    const { createInteractive } = await import("../Game/AI/gameplayLazy.js");
+    await createInteractive({ eventId: id });
+    window.dispatchEvent(new Event("oh:open-interactive-event"));
+  } catch (error) {
+    const rollback = await readWorldState({ force: true });
+    await writeWorldState({ ...rollback, interactiveOffer: null, ohx: { ...(rollback.ohx || {}), playedMomentIds: arr(rollback?.ohx?.playedMomentIds).filter((value) => text(value) !== id) } });
+    throw error;
+  } finally {
+    scheduleRefresh();
+  }
+};
+
+export const bootOHXExpansion = () => {
+  if (booted || typeof window === "undefined" || typeof document === "undefined") return;
+  booted = true;
+  situationRoom = new OHXSituationRoom({ getState: () => currentState, onPlayMoment: playMoment });
+  window.addEventListener("oh:world-updated", scheduleRefresh);
+  window.addEventListener("oh:game-updated", scheduleRefresh);
+  void refreshExpansion();
+};
diff --git a/src/runtime/ohxExpansionEngine.js b/src/runtime/ohxExpansionEngine.js
new file mode 100644
index 0000000..a77ffd8
--- /dev/null
+++ b/src/runtime/ohxExpansionEngine.js
@@ -0,0 +1,258 @@
+/*! Open Historia Expansion Layer — deterministic immersion systems, 2026. */
+
+const clean = (value) => String(value ?? "").replace(/\s+/g, " ").trim();
+const array = (value) => (Array.isArray(value) ? value : []);
+const finite = (value, fallback = 0) => (Number.isFinite(Number(value)) ? Number(value) : fallback);
+const clamp = (value, min = 0, max = 100) => Math.max(min, Math.min(max, finite(value, min)));
+const lower = (value) => clean(value).toLowerCase();
+
+const IMPORTANCE = { critical: 5, high: 4, major: 3, moderate: 2, minor: 1 };
+
+const KEYWORDS = Object.freeze({
+  market: ["market", "commerce", "trade", "finance", "bank", "currency", "sanction", "tariff", "prix", "marché", "commerce", "finance", "banque", "devise", "sanction", "douane"],
+  health: ["health", "hospital", "medicine", "medical", "public health", "healthcare", "santé", "hôpital", "médicament", "médical", "soins", "pharma", "overdose"],
+  logistics: ["port", "shipping", "supply", "logistics", "warehouse", "transport", "cargo", "container", "chaîne", "approvisionnement", "logistique", "entrepôt", "transport", "fret"],
+  diplomacy: ["summit", "treaty", "agreement", "negotiation", "ambassador", "diplomatic", "sanction", "sommet", "traité", "accord", "négociation", "ambassadeur", "diplomatique"],
+  security: ["security", "police", "customs", "intelligence", "spy", "arrest", "investigation", "sécurité", "police", "douane", "renseignement", "espion", "enquête", "arrestation"],
+  society: ["protest", "election", "public opinion", "media", "demonstration", "protestation", "opinion publique", "média", "manifestation", "grève", "strike"],
+  technology: ["digital", "cyber", "software", "platform", "algorithm", "AI", "numérique", "cyber", "plateforme", "algorithme", "technologie"],
+});
+
+const countKeywordHits = (text, words) => {
+  const hay = lower(text);
+  return words.reduce((sum, word) => sum + (hay.includes(lower(word)) ? 1 : 0), 0);
+};
+
+const eventText = (event) => [event?.title, event?.description, ...(event?.tags || [])].join(" ");
+
+const categoryScores = (event) => {
+  const text = eventText(event);
+  return Object.fromEntries(Object.entries(KEYWORDS).map(([key, words]) => [key, countKeywordHits(text, words)]));
+};
+
+const categoryOf = (event) => {
+  const scores = categoryScores(event);
+  return Object.entries(scores).sort((a, b) => b[1] - a[1])[0]?.[1] > 0
+    ? Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0]
+    : "general";
+};
+
+const isPlayableCandidate = (event) => {
+  if (!event || typeof event !== "object") return false;
+  if (!clean(event.id) || !clean(event.title) || !clean(event.description)) return false;
+  if (event.playerRelated !== true) return false;
+  if (["fallback", "espionage", "interactive"].includes(lower(event.source)) || lower(event.kind) === "interactive") return false;
+  return Boolean(IMPORTANCE[lower(event.importance)]) || event.notable === true;
+};
+
+const historyIds = (world) => {
+  const head = array(world?.simulationHistory)[0];
+  return new Set(array(head?.eventIds).map(clean).filter(Boolean));
+};
+
+const pickRecentEvents = ({ world, events }) => {
+  const ids = historyIds(world);
+  const current = array(events).filter((event) => ids.has(clean(event?.id)));
+  if (current.length) return current;
+  return array(events).slice(-18);
+};
+
+const activeAgreementPressure = (agreements) => array(agreements).filter((a) => ["active", "suspended"].includes(lower(a?.status))).length;
+const activeWarPressure = (wars) => array(wars).filter((w) => lower(w?.status) === "active").length;
+const activeProjectsPressure = (projects) => array(projects).filter((p) => ["active", "delayed", "stalled"].includes(lower(p?.status))).length;
+
+const average = (values, fallback = 50) => {
+  const nums = values.map(Number).filter(Number.isFinite);
+  return nums.length ? nums.reduce((a, b) => a + b, 0) / nums.length : fallback;
+};
+
+const topCountryNames = (world, playerName = "") => {
+  const seen = new Map();
+  const add = (name, weight = 1) => {
+    const n = clean(name);
+    if (!n) return;
+    seen.set(n, (seen.get(n) || 0) + weight);
+  };
+  add(playerName, 8);
+  for (const r of array(world?.relations)) {
+    add(r?.a, 2);
+    add(r?.b, 2);
+  }
+  for (const a of array(world?.agreements)) for (const p of array(a?.parties)) add(p, 1.5);
+  for (const w of array(world?.wars)) for (const p of [...array(w?.sideA), ...array(w?.sideB)]) add(p, 3);
+  return [...seen.entries()].sort((a, b) => b[1] - a[1]).slice(0, 24).map(([name]) => name);
+};
+
+export const buildInteractiveDeck = ({ world, events, round }) => {
+  const recent = pickRecentEvents({ world, events });
+  const played = new Set(array(world?.ohx?.playedMomentIds).map(clean));
+  const candidates = recent.filter((event) => isPlayableCandidate(event) && !played.has(clean(event.id)));
+  const scored = candidates.map((event, index) => {
+    const importance = IMPORTANCE[lower(event.importance)] || (event.notable ? 2 : 0);
+    const scores = categoryScores(event);
+    const breadth = Object.values(scores).filter((v) => v > 0).length;
+    const consequences = array(event?.impacts ? Object.keys(event.impacts) : []).length;
+    const recency = index / Math.max(1, candidates.length - 1);
+    const score = importance * 20 + (event.notable ? 12 : 0) + breadth * 5 + consequences * 3 + recency * 4;
+    const category = categoryOf(event);
+    const reasons = {
+      market: "Marchés et flux",
+      health: "Santé et capacité civile",
+      logistics: "Logistique et chaînes d'approvisionnement",
+      diplomacy: "Diplomatie et négociation",
+      security: "Sécurité et renseignement",
+      society: "Pression sociopolitique",
+      technology: "Technologie et information",
+      general: "Moment stratégique",
+    };
+    return {
+      eventId: clean(event.id),
+      title: clean(event.title),
+      date: clean(event.date),
+      category,
+      score,
+      reason: reasons[category] || reasons.general,
+    };
+  });
+  scored.sort((a, b) => b.score - a.score);
+  return {
+    round: finite(round, 1),
+    offers: scored.slice(0, 5),
+  };
+};
+
+export const deriveDynamics = ({ world, events }) => {
+  const recent = pickRecentEvents({ world, events });
+  const categoryTotals = Object.fromEntries(Object.keys(KEYWORDS).map((key) => [key, 0]));
+  let eventPressure = 0;
+  for (const event of recent) {
+    const weight = IMPORTANCE[lower(event?.importance)] || (event?.notable ? 2 : 1);
+    eventPressure += weight;
+    const scores = categoryScores(event);
+    for (const [key, hits] of Object.entries(scores)) categoryTotals[key] += hits * weight;
+  }
+
+  const storylinePressure = average(array(world?.storylines).filter((s) => lower(s?.status) === "active").map((s) => finite(s?.pressure)), 35);
+  const storylineMomentum = average(array(world?.storylines).filter((s) => lower(s?.status) === "active").map((s) => finite(s?.momentum)), 30);
+  const diplomacyHeat = clamp(activeWarPressure(world?.wars) * 10 + array(world?.relations).filter((r) => ["hostile", "rival", "strained"].includes(lower(r?.status))).length * 2 + activeAgreementPressure(world?.agreements));
+  const projectLoad = clamp(activeProjectsPressure(world?.projects) * 3);
+  const reportLoad = clamp(array(world?.reports).length * 0.6);
+  const spyLoad = clamp(array(world?.spies).filter((s) => lower(s?.status) === "active").length * 4);
+
+  const marketStress = clamp(30 + categoryTotals.market * 5 + categoryTotals.logistics * 2.5 + projectLoad * 0.8);
+  const healthPressure = clamp(20 + categoryTotals.health * 6 + categoryTotals.logistics * 1.2 + eventPressure * 0.3);
+  const logisticsStrain = clamp(20 + categoryTotals.logistics * 7 + projectLoad + categoryTotals.market * 1.5);
+  const informationNoise = clamp(15 + categoryTotals.technology * 6 + reportLoad + spyLoad + recent.length * 1.2);
+  const diplomaticHeatFinal = clamp(15 + diplomacyHeat + categoryTotals.diplomacy * 4);
+  const systemicRisk = clamp(0.28 * storylinePressure + 0.22 * storylineMomentum + 0.2 * marketStress + 0.14 * healthPressure + 0.16 * diplomaticHeatFinal);
+  const resilience = clamp(100 - (0.36 * logisticsStrain + 0.24 * marketStress + 0.18 * healthPressure + 0.12 * systemicRisk));
+  const reputationAverage = average(Object.values(world?.internationalReputation || {}).map(Number), 55);
+
+  return {
+    marketStress: Math.round(marketStress),
+    healthPressure: Math.round(healthPressure),
+    logisticsStrain: Math.round(logisticsStrain),
+    informationNoise: Math.round(informationNoise),
+    diplomaticHeat: Math.round(diplomaticHeatFinal),
+    systemicRisk: Math.round(systemicRisk),
+    resilience: Math.round(resilience),
+    institutionalTrust: Math.round(clamp(reputationAverage)),
+    pressure: Math.round(clamp(eventPressure * 4 + systemicRisk * 0.4)),
+    categories: Object.fromEntries(Object.entries(categoryTotals).map(([k, v]) => [k, Math.round(v)])),
+  };
+};
+
+export const deriveCrises = ({ world, events, dynamics }) => {
+  const recent = pickRecentEvents({ world, events });
+  const candidates = recent.filter((event) => Boolean(IMPORTANCE[lower(event?.importance)]) || event?.notable === true);
+  return candidates.slice().sort((a, b) => {
+    const wa = (IMPORTANCE[lower(a?.importance)] || 2) + (a?.notable ? 1 : 0);
+    const wb = (IMPORTANCE[lower(b?.importance)] || 2) + (b?.notable ? 1 : 0);
+    return wb - wa;
+  }).slice(0, 8).map((event) => {
+    const category = categoryOf(event);
+    const severity = clamp((IMPORTANCE[lower(event?.importance)] || 2) * 18 + (event?.notable ? 14 : 0) + dynamics.systemicRisk * 0.22 + dynamics.pressure * 0.15);
+    return {
+      id: `crisis-${clean(event.id)}`,
+      eventId: clean(event.id),
+      title: clean(event.title),
+      category,
+      severity: Math.round(severity),
+      status: severity >= 72 ? "critical" : severity >= 52 ? "active" : "watch",
+      date: clean(event.date),
+      description: clean(event.description).slice(0, 320),
+    };
+  });
+};
+
+export const deriveActors = ({ world, dynamics, playerName = "" }) => {
+  const names = topCountryNames(world, playerName);
+  return names.map((name) => {
+    const relations = array(world?.relations).filter((r) => lower(r?.a) === lower(name) || lower(r?.b) === lower(name));
+    const reputation = finite((world?.internationalReputation || {})[name], 50);
+    const hostile = relations.filter((r) => ["hostile", "rival", "strained"].includes(lower(r?.status))).length;
+    const friendly = relations.filter((r) => ["friendly", "cordial"].includes(lower(r?.status))).length;
+    const influence = clamp(45 + Math.abs(average(relations.map((r) => finite(r?.score)), 0)) * 0.22 + reputation * 0.25 + friendly * 4 - hostile * 5);
+    const pressure = clamp(25 + dynamics.diplomaticHeat * 0.45 + hostile * 10 + Math.max(0, 55 - reputation) * 0.4);
+    return { name, influence: Math.round(influence), pressure: Math.round(pressure), reputation: Math.round(clamp(reputation)), hostile, friendly };
+  }).sort((a, b) => b.influence - a.influence).slice(0, 12);
+};
+
+
+export const deriveStorylines = ({ world }) => array(world?.storylines)
+  .filter((s) => ["active", "dormant"].includes(lower(s?.status)))
+  .slice()
+  .sort((a, b) => (finite(b?.pressure) + finite(b?.momentum) * 0.7) - (finite(a?.pressure) + finite(a?.momentum) * 0.7))
+  .slice(0, 18)
+  .map((s) => ({
+    id: clean(s?.id),
+    title: clean(s?.title) || "Persistent thread",
+    kind: clean(s?.kind) || "world",
+    status: lower(s?.status) || "active",
+    pressure: Math.round(clamp(s?.pressure)),
+    momentum: Math.round(clamp(s?.momentum)),
+    nextReviewDate: clean(s?.nextReviewDate),
+    state: clean(s?.state).slice(0, 300),
+    participants: array(s?.participants).map(clean).filter(Boolean).slice(0, 6),
+  }));
+
+export const deriveCommitments = ({ world }) => array(world?.agreements)
+  .filter((a) => ["active", "suspended"].includes(lower(a?.status)))
+  .slice()
+  .sort((a, b) => String(a?.status).localeCompare(String(b?.status)) || String(a?.title).localeCompare(String(b?.title)))
+  .slice(0, 18)
+  .map((a) => ({
+    id: clean(a?.id),
+    title: clean(a?.title) || "Unnamed agreement",
+    type: clean(a?.type) || "other",
+    status: lower(a?.status) || "active",
+    parties: array(a?.parties).map(clean).filter(Boolean).slice(0, 6),
+    terms: clean(a?.terms).slice(0, 280),
+  }));
+
+export const buildExpansionState = ({ world, events, game }) => {
+  const round = finite(game?.round, 1);
+  const dynamics = deriveDynamics({ world, events });
+  const crises = deriveCrises({ world, events, dynamics });
+  const actors = deriveActors({ world, dynamics, playerName: game?.country || "" });
+  const commitments = deriveCommitments({ world });
+  const storylines = deriveStorylines({ world });
+  const old = world?.ohx && typeof world.ohx === "object" ? world.ohx : {};
+  const deck = buildInteractiveDeck({ world, events, round });
+  const playedMomentIds = array(old.playedMomentIds).map(clean).filter(Boolean).slice(-280);
+  const metricsHistory = [...array(old.metricsHistory), { round, date: clean(game?.gameDate), ...dynamics }].slice(-24);
+  return {
+    version: 1,
+    round,
+    gameDate: clean(game?.gameDate),
+    metrics: dynamics,
+    crises,
+    actors,
+    commitments,
+    storylines,
+    interactiveDeck: deck,
+    playedMomentIds,
+    metricsHistory,
+    lastUpdatedAt: new Date().toISOString(),
+  };
+};
